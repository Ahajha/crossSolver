"""Nonagram solver"""

bazel_dep(name = "rules_cc", version = "0.2.26")

# For hedron_compile_commands. Not sure why I have to do this?
bazel_dep(name = "rules_python", version = "2.0.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Refresh compile commands with
# bazelisk run @hedron_compile_commands//:refresh_all
http_archive(
    name = "hedron_compile_commands",
    dev_dependency = True,
    integrity = "sha256-ihYoI2iAkbxaGNXJu/+yq52VSS9FlAwr9iUIQknV/4k=",
    strip_prefix = "bazel-compile-commands-extractor-e9ca1877fba7cebbb7630c6e1938293ee676d929",
    url = "https://github.com/modular/bazel-compile-commands-extractor/archive/e9ca1877fba7cebbb7630c6e1938293ee676d929.tar.gz",
)

http_archive(
    name = "ctpl",
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")
cc_library(
    name = "ctpl",
    hdrs = ["ctpl_stl.h", "tpp/ctpl_stl.tpp"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "00ea87d80dc97c9509737ecdf82d66260874fb099815d8ebcf01c00d16fb631c",
    strip_prefix = "CTPL-a93cc7caa0c27760e74bf8eb493e80bb27a781de",
    url = "https://github.com/Ahajha/CTPL/archive/a93cc7caa0c27760e74bf8eb493e80bb27a781de.tar.gz",
)

http_archive(
    name = "esbmc",
    build_file_content = """
exports_files(["bin/esbmc", "include/esbmc.h"])
""",
    integrity = "sha256-2NowTdDfzmyfSIN58Dpy52i86FmMIkeMmA4XBCRzUvE=",
    strip_prefix = "release",
    url = "https://github.com/esbmc/esbmc/releases/download/v8.5/esbmc-linux.zip",
