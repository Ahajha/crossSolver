load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "nonagram",
    srcs = [
        "src/bmp.cpp",
        "src/nonagram.cpp",
    ],
    hdrs = [
        "src/bmp.hpp",
        "src/index_generator.hpp",
        "src/nonagram.hpp",
    ],
)

cc_binary(
    name = "batch_solver",
    srcs = ["src/batch_solver.cpp"],
    deps = [
        ":nonagram",
        "@ctpl",
    ],
)

cc_binary(
    name = "solver",
    srcs = ["src/solver.cpp"],
    deps = [":nonagram"],
)

genrule(
    name = "validate",
    srcs = [
        "src/bmp.cpp",
        "src/nonagram.cpp",
        "src/solver.cpp",
        "src/bmp.hpp",
        "src/index_generator.hpp",
        "src/nonagram.hpp",
        "@esbmc//:bin/esbmc",
        "@esbmc//:include/esbmc.h",
    ],
    # minor todo: really this is a test
    outs = ["success"],
    cmd = """
    $(location @esbmc//:bin/esbmc) \
        --std=c++20 \
        --color=always \
        --no-standard-checks \
        --no-library-assertions \
        -I $(location @esbmc//:include/esbmc.h)/.. \
        $(location src/bmp.cpp) \
        $(location src/nonagram.cpp) \
        $(location src/solver.cpp)
    touch $(location success)
""",
    tags = ["manual"],
)
